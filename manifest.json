{
  "manifest_version": 3,
  "name": "Twitch Extension",
  "version": "2.4",
  "description": "Предоставляет статистику с Twitch Tracker и Sullygnome",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.twitch.tv/*"],
      "js": ["main.js"],
      "css": ["styles.css"]
    }
  ]
}